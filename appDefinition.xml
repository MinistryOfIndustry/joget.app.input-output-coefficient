                  <pluginProperties>{&quot;runInMultiThread&quot;:&quot;&quot;,&quot;comment&quot;:&quot;&quot;,&quot;tools&quot;:[{&quot;className&quot;:&quot;org.joget.apps.app.lib.EmailTool&quot;,&quot;properties&quot;:{&quot;cc&quot;:&quot;packmutangana@gmail.com&quot;,&quot;toSpecific&quot;:&quot;#form.eth_ioc_item_request.email#&quot;,&quot;bcc&quot;:&quot;&quot;,&quot;icsAttachement&quot;:&quot;&quot;,&quot;subject&quot;:&quot;New raw material input request status&quot;,&quot;retryCount&quot;:&quot;&quot;,&quot;formDefId&quot;:&quot;&quot;,&quot;toParticipantId&quot;:&quot;#form.eth_ioc_item_request.email#&quot;,&quot;message&quot;:&quot;Hello  #form.eth_ioc_item_request.firstName# ,\n\nYour application for the raw material input \&quot;#variable.merge_inputs_title#\&quot; was rejected \n\nReason:\n#form.eth_ioc_item_request.moi_comments#\n\nThank you,\nThe Ministry of Industry team&quot;,&quot;p12&quot;:&quot;&quot;,&quot;security&quot;:&quot;TLS&quot;,&quot;password&quot;:&quot;jtiw gejx ghzs wkgt&quot;,&quot;storepass&quot;:&quot;jtiw gejx ghzs wkgt&quot;,&quot;port&quot;:&quot;587&quot;,&quot;isHtml&quot;:&quot;&quot;,&quot;host&quot;:&quot;smtp.gmail.com&quot;,&quot;alias&quot;:&quot;&quot;,&quot;files&quot;:[],&quot;from&quot;:&quot;moi.ethiopia@gmail.com&quot;,&quot;retryInterval&quot;:&quot;&quot;,&quot;fields&quot;:[],&quot;username&quot;:&quot;moi.ethiopia@gmail.com&quot;}}]}</pluginProperties>
