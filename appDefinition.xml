            <entry>
               <string>newRawMatTypeToExistingProductProcess::stringfyTheProduct</string>
               <packageActivityPlugin>
                  <processDefId>newRawMatTypeToExistingProductProcess</processDefId>
                  <activityDefId>stringfyTheProduct</activityDefId>
                  <pluginName>org.joget.apps.app.lib.MultiTools</pluginName>
                  <pluginProperties>{&quot;runInMultiThread&quot;:&quot;&quot;,&quot;comment&quot;:&quot;&quot;,&quot;tools&quot;:[{&quot;className&quot;:&quot;org.joget.apps.app.lib.BeanShellTool&quot;,&quot;properties&quot;:{&quot;script&quot;:&quot;import java.sql.*;\nimport javax.sql.DataSource;\nimport org.joget.apps.app.service.AppUtil;\nimport org.joget.commons.util.LogUtil;\nimport org.json.JSONArray;\nimport org.json.JSONObject;\nimport org.joget.plugin.base.PluginManager;\nimport org.joget.workflow.model.service.WorkflowManager;\n\nfinal String LOGGER    = \&quot;IOC-BeanShell\&quot;;\nfinal String REQ_TBL   = \&quot;app_fd_eth_ioc_item_request\&quot;;\nfinal String HV_REQ_ID = \&quot;#form.eth_ioc_item_request.id#\&quot;;\n\n\nString hv(String expr){\n    try{\n        String v = AppUtil.processHashVariable(expr, workflowAssignment, null, null);\n        if (v == null) return null;\n        v = v.trim();\n        return (v.length()==0 || v.indexOf(&apos;#&apos;)&gt;=0) ? null : v;\n    }catch(Exception e){ return null; }\n}\nboolean blank(String s){ return s==null || s.trim().isEmpty() || \&quot;null\&quot;.equalsIgnoreCase(s.trim()); }\n\n/* ===== MAIN ===== */\nConnection con=null; PreparedStatement ps=null; ResultSet rs=null;\ntry{\n    String reqId = hv(HV_REQ_ID);\n    if (reqId == null){\n        LogUtil.warn(LOGGER, \&quot;Request ID not resolved.\&quot;);\n        // still clear the variable so UI doesn&apos;t show stale data\n        PluginManager pm = (PluginManager) AppUtil.getApplicationContext().getBean(\&quot;pluginManager\&quot;);\n        WorkflowManager wm = (WorkflowManager) pm.getBean(\&quot;workflowManager\&quot;);\n        wm.activityVariable(workflowAssignment.getActivityId(), \&quot;merge_inputs_title\&quot;, \&quot;\&quot;);\n        return \&quot;no-id\&quot;;\n    }\n\n    DataSource ds = (DataSource) AppUtil.getApplicationContext().getBean(\&quot;setupDataSource\&quot;);\n    con = ds.getConnection();\n\n    ps = con.prepareStatement(\&quot;SELECT c_addRawMaterialItem FROM \&quot; + REQ_TBL + \&quot; WHERE id=?\&quot;);\n    ps.setString(1, reqId);\n    rs = ps.executeQuery();\n\n    String itemsJson = null;\n    if (rs.next()){\n        itemsJson = rs.getString(\&quot;c_addRawMaterialItem\&quot;);\n    } else {\n        LogUtil.warn(LOGGER, \&quot;No request row found for id=\&quot; + reqId);\n    }\n\n    String mergedTitles = \&quot;\&quot;;\n    if (!blank(itemsJson)){\n        try{\n            JSONArray arr = new JSONArray(itemsJson);\n            StringBuilder sb = new StringBuilder();\n            for (int i=0; i&lt;arr.length(); i++){\n                JSONObject obj = arr.optJSONObject(i);\n                if (obj == null) continue;\n                String title = obj.optString(\&quot;input_description\&quot;, null);\n\n\n                if (!blank(title)){\n                    if (sb.length() &gt; 0) sb.append(\&quot;, \&quot;);\n                    sb.append(title);\n                }\n            }\n            mergedTitles = sb.toString();\n        }catch(Exception je){\n            LogUtil.warn(LOGGER, \&quot;Invalid JSON in c_addRawMaterialItem for id=\&quot; + reqId + \&quot;: \&quot; + je.getMessage());\n        }\n    } else {\n        LogUtil.info(LOGGER, \&quot;Empty or null c_addRawMaterialItem for id=\&quot; + reqId);\n    }\n\n    try{\n        PluginManager pm = (PluginManager) AppUtil.getApplicationContext().getBean(\&quot;pluginManager\&quot;);\n        WorkflowManager wm = (WorkflowManager) pm.getBean(\&quot;workflowManager\&quot;);\n        wm.activityVariable(workflowAssignment.getActivityId(), \&quot;merge_inputs_title\&quot;, mergedTitles);\n        LogUtil.info(LOGGER, \&quot;Set merge_inputs_title = \&quot; + mergedTitles);\n    }catch(Exception wex){\n        LogUtil.warn(LOGGER, \&quot;Failed to set workflow variable &apos;merge_inputs_title&apos;: \&quot; + wex.getMessage());\n    }\n\n    return \&quot;success\&quot;;\n\n}catch(Exception e){\n    LogUtil.error(LOGGER, e, \&quot;FAILED: \&quot; + e.getMessage());\n    try{\n        PluginManager pm = (PluginManager) AppUtil.getApplicationContext().getBean(\&quot;pluginManager\&quot;);\n        WorkflowManager wm = (WorkflowManager) pm.getBean(\&quot;workflowManager\&quot;);\n        wm.activityVariable(workflowAssignment.getActivityId(), \&quot;merge_inputs_title\&quot;, \&quot;\&quot;);\n    }catch(Exception ignore){}\n    return \&quot;error\&quot;;\n}finally{\n    try{ if(rs!=null) rs.close(); }catch(Exception ig){}\n    try{ if(ps!=null) ps.close(); }catch(Exception ig){}\n    try{ if(con!=null) con.close(); }catch(Exception ig){}\n}\n&quot;}}]}</pluginProperties>
               </packageActivityPlugin>
            </entry>
