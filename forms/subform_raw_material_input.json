                {
                    "className": "org.joget.apps.form.lib.CustomHTML",
                    "properties": {
                        "requiredSanitize": "",
                        "autoPopulate": "",
                        "label": "",
                        "id": "field6",
                        "value": "<script>\n  // runs when DOM is ready\n  $(function () {\n    const selector = '#quantity, #waste_percentage';\n\n    function calculateCommercial() {\n      const q = parseFloat($('#quantity').val()) || 0;\n      const w = parseFloat($('#waste_percentage').val()) || 0;\n\n      // q * (1 + w/100), clamped at 0 and formatted\n      const io = Math.max(0, q * (1 + w / 100));\n      $('#input_output_coefficient')\n        .val(io.toFixed(2))\n        .prop('readonly', true);\n    }\n\n    // Event delegation handles typing, paste, autofill, and dynamic re-renders\n    $(document).on('input change', selector, calculateCommercial);\n\n    // Initial calc (in case defaults/pre-filled values exist)\n    calculateCommercial();\n  });\n<\/script>"
