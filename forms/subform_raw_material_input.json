                        "value": "<script>\n$(document).ready(function() {\n    $(\"[id$='_allHsCode']\").on('autocompleteselect', function(event, ui) {\n\t\tselectorElement = $(this);\n\t\ttargetElement = selectorElement.closest('.subform-column').find(\"[id$='_hscode']\");\n\t\ttargetElementValueOptions = targetElement.val().split(',');\n\t\ttargetElementValueOptions.push(ui.item.value);\n\t\ttargetElementValueOptions = targetElementValueOptions.filter(function(v){return v!==''});\n\t\ttargetElementValueOptions = $.unique(targetElementValueOptions);\n\t\ttargetElement.val(targetElementValueOptions.join(','));\n\t\tselectorElement.val('');\n    });\n});\n<\/script>\n"
