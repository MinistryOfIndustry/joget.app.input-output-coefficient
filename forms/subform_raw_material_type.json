                    "className": "org.joget.apps.form.lib.CustomHTML",
                    "properties": {
                        "requiredSanitize": "",
                        "autoPopulate": "",
                        "label": "",
                        "id": "field8",
                        "value": "<script>\r\n\t$(document).ready(function(){\t\t\r\n\t\t$('.unique_value[name^=\"add_products_\"][name$=\"_raw_material_type_unique_value\"]').each(function(){\r\n\t\t\tvar subformId = $(this).attr('name').replace('_unique_value', '') + '_' + $(this).val();\r\n\t\t\t$('#' + subformId + '_quantity').off('change').change(function(){\r\n\t\t\t\tupdateInputOutputCoeficient(subformId);\r\n\t\t\t});\r\n\t\t\t$('#' + subformId + '_waste_percentage').off('change').change(function(){\r\n\t\t\t\tupdateInputOutputCoeficient(subformId);\r\n\t\t\t});\r\n\t\t});\r\n\t\t\r\n\t\tfunction updateInputOutputCoeficient(subformId) {\r\n\t\t\tvar quantity = parseInt($('#' + subformId + '_quantity').val()) || 0;\r\n\t\t\tvar wastePercentage = parseInt($('#' + subformId + '_waste_percentage').val()) || 0;\r\n\t\t\tvar io = quantity + (quantity * (wastePercentage/100));\r\n\t\t\t\r\n\t\t\t$('#' + subformId + '_input_output_coefficient').val(io >= 0 ? io : 0)\r\n\t\t\t.prop('readonly', true);\r\n\t\t}\r\n\t});\t\r\n<\/script>"
