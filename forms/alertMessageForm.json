{
    "elements": [{
        "elements": [{
            "elements": [{
                "className": "org.joget.apps.form.lib.CustomHTML",
                "properties": {
                    "requiredSanitize": "",
                    "autoPopulate": "",
                    "label": "",
                    "id": "messageScreen",
                    "value": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Submission Successful \u2014 Input-Output Coefficient System<\/title>\n  <style>\n    :root{\n      --brand-bg:#355179;        /* banner blue (tuned to your screenshot) */\n      --brand-blue:#2f4f75;\n      --accent:#15a34a;          /* success green */\n      --accent-ink:#0b6b31;\n      --ink:#0f172a;\n      --muted:#475569;\n      --surface:#ffffff;\n      --surface-2:#f8fafc;\n      --ring:#cbd5e1;\n    }\n    *{box-sizing:border-box}\n    html,body{height:100%}\n    body{\n      margin:0;\n      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;\n      color:var(--ink);\n      background:var(--surface-2);\n      line-height:1.5;\n    }\n\n    /* Banner */\n    .banner{\n      background:var(--brand-bg);\n      color:#fff;\n      padding:28px clamp(16px,4vw,40px);\n      display:flex;\n      align-items:center;\n      gap:24px;\n    }\n    .banner__title{\n      font-size:clamp(22px,2.3vw,34px);\n      font-weight:800;\n      letter-spacing:.2px;\n      margin:0 0 6px 0;\n    }\n    .banner__subtitle{\n      margin:0;\n      opacity:.9;\n      font-size:clamp(12px,1.3vw,16px);\n      font-weight:500;\n    }\n    .banner__spacer{flex:1}\n    .banner__logo{\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      width:86px;height:86px;\n      border-radius:12px;\n      background:#fff;\n      overflow:hidden;\n    }\n    .banner__logo svg{width:64px;height:64px}\n\n    /* Main card */\n    .container{\n      max-width:960px;\n      margin:32px auto;\n      padding:0 16px;\n    }\n    .card{\n      background:var(--surface);\n      border:1px solid var(--ring);\n      border-radius:16px;\n      padding:28px;\n      box-shadow:0 10px 24px rgba(2,6,23,.06);\n    }\n\n    .success{\n      display:flex;\n      align-items:flex-start;\n      gap:18px;\n    }\n    .success__icon{\n      flex:0 0 auto;\n      width:60px;height:60px;border-radius:50%;\n      display:grid;place-items:center;\n      background:color-mix(in oklab, var(--accent) 16%, white);\n      border:2px solid var(--accent);\n    }\n    .success__icon svg{width:34px;height:34px;fill:var(--accent-ink)}\n    .success__title{\n      margin:2px 0 4px 0;\n      font-size:clamp(18px,2vw,26px);\n      font-weight:800;\n      letter-spacing:.2px;\n    }\n    .success__lead{\n      margin:0 0 14px 0;\n      color:var(--muted);\n      font-size:15px;\n    }\n\n    .kv{\n      display:grid;\n      grid-template-columns: 180px 1fr;\n      gap:8px 16px;\n      padding:16px;\n      border:1px dashed var(--ring);\n      border-radius:12px;\n      background: #fcfdfd;\n      margin:14px 0 18px 0;\n      font-size:14px;\n    }\n    .kv dt{color:#334155;font-weight:600}\n    .kv dd{margin:0;color:#0f172a}\n\n    .actions{\n      display:flex;flex-wrap:wrap;gap:12px;margin-top:6px\n    }\n    .btn{\n      appearance:none;border:0;border-radius:10px;\n      padding:10px 16px;\n      font-weight:700;cursor:pointer;\n      transition:transform .04s ease, box-shadow .2s ease;\n      box-shadow:0 2px 0 rgba(2,6,23,.1);\n    }\n    .btn:active{transform:translateY(1px)}\n    .btn--primary{\n      background:var(--brand-blue);color:#fff;\n    }\n    .btn--ghost{\n      background:#fff;border:1px solid var(--ring);color:#0f172a;\n    }\n    .btn--success{\n      background:var(--accent);color:#fff;\n    }\n\n    .tips{\n      margin-top:18px;\n      font-size:13px;color:#64748b\n    }\n\n    /* Print */\n    @media print{\n      .actions,.tips,.banner__logo{display:none}\n      .card{box-shadow:none;border:0;padding:0}\n      body{background:#fff}\n      .container{margin:0}\n    }\n  <\/style>\n  \n     <script type=\"text/javascript\">\n            $(document).ready( function(){\n            $(\"#submit\").hide();\n            // $(\"#complete\").hide();\n            $(\"#assignmentComplete\").hide();\n            $(\"#cancel\").hide();\n            $(\"#saveAsDraft\").hide();\n            $(\".print-button\").hide();\n            });\n        <\/script>\n<\/head>\n<body>\n  <!-- Top banner -->\n  <header class=\"banner\" role=\"banner\" aria-label=\"System banner\">\n    <div>\n      <h1 class=\"banner__title\">Input-Output Coefficient System<\/h1>\n      <p class=\"banner__subtitle\">National Standard Input-Output Coefficient Management Platform<\/p>\n    <\/div>\n    <div class=\"banner__spacer\"><\/div>\n    <!-- Logo placeholder; replace the SVG or embed your raster logo -->\n    <div class=\"banner__logo\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Logo\">\n        <path d=\"M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8.009 8.009 0 0 1-8 8z\"/>\n        <path d=\"M7 15h2V9H7zm4 0h2V6h-2zm4 0h2v-4h-2z\"/>\n      <\/svg>\n    <\/div>\n  <\/header>\n\n  <!-- Main content -->\n  <main class=\"container\" role=\"main\">\n    <section class=\"card\" aria-live=\"polite\" aria-atomic=\"true\">\n      <div class=\"success\">\n        <div class=\"success__icon\" aria-hidden=\"true\">\n          <!-- Check icon -->\n          <svg viewBox=\"0 0 24 24\" focusable=\"false\" aria-hidden=\"true\">\n            <path d=\"M9.55 17.1 4.9 12.45l1.4-1.4 3.25 3.25L17.7 6.35l1.4 1.4z\"/>\n          <\/svg>\n        <\/div>\n        <div>\n          <h2 class=\"success__title\">Submission Successful<\/h2>\n          <p class=\"success__lead\">\n            Your request has been received and recorded. A confirmation has been generated with the details below.\n          <\/p>\n\n          <dl class=\"kv\">\n           \n\n            <dt>Submitted By<\/dt>\n            <dd id=\"submittedBy\">#currentUser.firstName#<\/dd>\n\n\n            <dt>Status<\/dt>\n            <dd><strong style=\"color:var(--accent-ink)\">Received<\/strong> \u2014 pending verification<\/dd>\n          <\/dl>\n\n          <div class=\"actions\">\n            <!--<button class=\"btn btn--success\" onclick=\"window.print()\">Download / Print Receipt<\/button>-->\n            <!--<a class=\"btn btn--primary\" onclick=\"goToStatus()\">View Status<\/a>-->\n            <a class=\"btn btn--ghost\" \n            href=\"#appVariable.currentAppUrl#/userview/inputOutputCoefficientPoC/portal/_/myNewItemRequestListMenu\">Back to Home<\/a>\n          <\/div>\n\n          <p class=\"tips\">\n            You\u2019ll also receive an email confirmation (if your request approved).\n          <\/p>\n        <\/div>\n      <\/div>\n    <\/section>\n  <\/main>\n\n  <script>\n    // Tiny helper to show current time and optionally inject dynamic values.\n    (function(){\n      const ts = new Date();\n      const fmt = new Intl.DateTimeFormat(undefined, {\n        year:'numeric', month:'short', day:'2-digit',\n        hour:'2-digit', minute:'2-digit', second:'2-digit'\n      });\n      const el = document.getElementById('submittedAt');\n      if (el) el.textContent = fmt.format(ts);\n\n      // If you have runtime data, set them here:\n      // document.getElementById('refId').textContent = window.confirmation.refId;\n      // document.getElementById('submittedBy').textContent = window.confirmation.userName;\n    })();\n\n    function goToStatus(){\n      // Replace with your real route\n      window.location.href = '/applications/status';\n    }\n    function goHome(){\n      // Replace with your real route\n      window.location.href = '/dashboard';\n    }\n  <\/script>\n<\/body>\n<\/html>\n"
                }
