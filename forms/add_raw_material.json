                        "id": "field11",
                        "value": "<div style=\"display:none;\">\n    <script>\n        $(document).ready(function(){\n        console.log(\"Script is running...\");\n        function calculateCommercial() {\n            var quantity = parseInt($('#quantity').val()) || 0;\n            var wastePercentage = parseInt($('#waste_percentage').val()) || 0;\n            var io = quantity + (quantity * (wastePercentage/100));\n            \n            $('#input_output_coefficient').val(io >= 0 ? io : 0)\n            .prop('readonly', true);\n        }\n        // Bind the calculation function to input field changes\n        $('#quantity, #waste_percentage').on('input', calculateCommercial);\n\n        // Perform initial calculation in case there are default values\n        calculateCommercial();\n        });\n    <\/script>\n<\/div>"
