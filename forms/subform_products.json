                        "autoPopulate": "",
                        "label": "",
                        "id": "field8",
                        "value": "<a href=\"#\" class=\"copy_product\">Copy Product from request<\/a>\n\n<script>\n\t$(document).ready(function() {\n\t\t$(\".copy_product\").off('click').click(function(e){\n\t\t\te.preventDefault();\n\t\t\t$subform = $(this).closest('.subform_wrapper');\n\t\t\t$subformId = $subform.find('input[name=\"add_products_unique_value\"]').first().val();\n\t\t\t$('input[name=\"add_products_' + $subformId + '_product\"]').val($('#requested__product').val());\n\t\t});\n\t\t\n\t});\n<\/script>\n\n\n"
